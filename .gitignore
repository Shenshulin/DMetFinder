# ---- AI assistant / local working data (not part of the application) ----
.workbuddy/

# ---- DNN reference tree: build artefacts, not source ----
# Downloaded wheels are 335 MB of third-party binaries; the venv lives outside
# the project entirely (see DNN_reference/.venv_path).
DNN_reference/_wheels/
DNN_reference/.venv/
# The 25 MB training archive is reproducible from MassIVE MSV000084186; its
# URL, size and SHA-256 are recorded in DNN_reference/DATA_MANIFEST.csv.
DNN_reference/source_data/*.mat
# Per-run outputs; the frozen model and its log ARE tracked.
DNN_reference/processed_data/
# Machine-local pointer to the analysis venv (C:/Users/<user>/pqdnn-venv).
DNN_reference/.venv_path
# Upstream author clone. Pinned to commit 94237bf in DATA_MANIFEST.csv, so it is
# reproduced with `git clone` rather than tracked here; the licence text that
# must accompany the derived weights is kept as source_code/LICENSE.JainLab.txt.
DNN_reference/source_code/repo/

# ---- Paper bundle: the zip is the artefact, not its extraction ----
# data_for_paper/DMetFinder1.0.3.zip is tracked; unpacking it yields a full
# Windows JRE (183 files, 289 MB) that duplicates the archive contents.
data_for_paper/DMetFinder1.0.3/

# ---- R session and project artefacts ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
# Machine-local pointer to the isolated CPC library (C:/rlib/cpc).
# Recipe: .workbuddy/tools/install_cpc.R ; the path differs per machine.
.Renviron

# Console dumps from ad-hoc `Rscript app.R &> _app_run_<port>.log` runs.
# The RtGeter module now writes its own per-run log under .workbuddy/logs/,
# which is ignored with the rest of .workbuddy/.
_app_run_*.log

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
